{
  "name": "dsh-agent-webops",
  "version": "0.2.2",
  "description": "浏览器自主操作插件：爱丽丝经 CDP 自主开页/点击/输入/读取/截图/等待/读控制台；v0.2.0 起可 **attach 已运行的外部 CDP 端点**（Tauri/WebView2、Electron）做 DOM 级界面驱动——GUI 验证全自主，不依赖主人手动操作。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "license": "MIT",
  "allowScripts": [],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"tests/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
